<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.dodast.Controller.ChatController"
            prefHeight="600.0" prefWidth="900.0">
    <top>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <Button text="بازگشت" onAction="#backToMessages"/>
            <Label fx:id="titleLabel" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
        </HBox>
    </top>
    <center>
        <ListView fx:id="messagesListView"/>
    </center>
    <bottom>
        <HBox spacing="10" alignment="CENTER">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <TextField fx:id="messageField" promptText="متن پیام..." HBox.hgrow="ALWAYS"/>
            <Button text="ارسال" onAction="#sendMessage"/>
            <Label fx:id="errorLabel"/>
        </HBox>
    </bottom>
</BorderPane>
