<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.dodast.Controller.AdvertisementFormController"
            styleClass="page"
            nodeOrientation="RIGHT_TO_LEFT">

    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="15"
              styleClass="navbar">

            <padding>
                <Insets top="15"
                        right="25"
                        bottom="15"
                        left="25"/>
            </padding>

            <Label fx:id="pageTitleLabel"
                   text="فرم آگهی"
                   styleClass="brand"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="بازگشت"
                    onAction="#handleBack"
                    styleClass="back-button"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    styleClass="detail-scroll">

            <content>
                <VBox alignment="TOP_CENTER"
                      spacing="18"
                      maxWidth="580"
                      styleClass="advertisement-form-card">

                    <padding>
                        <Insets top="30"
                                right="35"
                                bottom="35"
                                left="35"/>
                    </padding>

                    <Label text="اطلاعات آگهی"
                           styleClass="section-title"/>

                    <TextField fx:id="titleField"
                               promptText="عنوان آگهی"
                               maxWidth="500"/>

                    <TextArea fx:id="descriptionField"
                              promptText="توضیحات آگهی"
                              prefRowCount="6"
                              wrapText="true"
                              maxWidth="500"/>

                    <TextField fx:id="priceField"
                               promptText="قیمت"
                               maxWidth="500"/>

                    <Separator/>

                    <Label text="دسته‌بندی و موقعیت"
                           styleClass="section-title"/>

                    <ComboBox fx:id="categoryComboBox"
                              promptText="دسته‌بندی"
                              maxWidth="500"/>

                    <ComboBox fx:id="provinceComboBox"
                              promptText="استان"
                              maxWidth="500"/>

                    <ComboBox fx:id="cityComboBox"
                              promptText="شهر"
                              maxWidth="500"/>

                    <VBox fx:id="imageSection"
                          alignment="CENTER"
                          spacing="12"
                          maxWidth="500"
                          styleClass="image-upload-box">

                        <Separator/>

                        <Label text="تصویر آگهی"
                               styleClass="section-title"/>

                        <Button text="انتخاب تصویر"
                                onAction="#chooseImage"
                                styleClass="secondary-button"/>

                        <Label fx:id="imageNameLabel"
                               text="تصویری انتخاب نشده"
                               wrapText="true"
                               styleClass="image-name-label"/>
                    </VBox>

                    <Label fx:id="messageLabel"
                           visible="false"
                           managed="false"
                           wrapText="true"
                           maxWidth="500"
                           styleClass="error-message"/>

                    <Button fx:id="submitButton"
                            text="ثبت آگهی"
                            onAction="#handleSubmit"
                            maxWidth="500"
                            styleClass="submit-button"/>
                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>