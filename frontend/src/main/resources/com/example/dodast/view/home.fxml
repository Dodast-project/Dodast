<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.dodast.Controller.HomeController"
            styleClass="page"
            nodeOrientation="RIGHT_TO_LEFT">

    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="15"
              styleClass="navbar">

            <padding>
                <Insets top="15"
                        right="25"
                        bottom="15"
                        left="25"/>
            </padding>

            <Label text="دودست"
                   styleClass="brand"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Label fx:id="usernameLabel"
                   styleClass="username-label"/>

            <Button text="ثبت آگهی"
                    onAction="#openCreateAdvertisement"/>

            <Button text="پیام‌ها"
                    onAction="#goToMessages"/>

            <Button text="علاقه‌مندی‌ها"
                    onAction="#showFavorites"/>

            <Button text="آگهی‌های من"
                    onAction="#openMyAdvertisements"/>

            <Button text="خروج"
                    onAction="#logout"/>
        </HBox>
    </top>

    <center>

        <VBox spacing="22">

            <padding>
                <Insets top="25"
                        right="35"
                        bottom="25"
                        left="35"/>
            </padding>

            <VBox spacing="15"
                  styleClass="search-panel">

                <padding>
                    <Insets top="18"
                            right="18"
                            bottom="18"
                            left="18"/>
                </padding>

                <HBox spacing="10"
                      alignment="CENTER">

                    <TextField fx:id="keywordField"
                               promptText="جستجوی عنوان..."
                               prefWidth="220"/>

                    <ComboBox fx:id="categoryComboBox"
                              promptText="دسته‌بندی"
                              prefWidth="150"/>

                    <Button text="×"
                            styleClass="clear-button"
                            onAction="#clearCategory"/>

                    <ComboBox fx:id="provinceComboBox"
                              promptText="استان"
                              prefWidth="150"/>

                    <Button text="×"
                            styleClass="clear-button"
                            onAction="#clearProvince"/>

                    <ComboBox fx:id="cityComboBox"
                              promptText="شهر"
                              prefWidth="150"/>

                    <Button text="×"
                            styleClass="clear-button"
                            onAction="#clearCity"/>

                    <ComboBox fx:id="sortComboBox"
                              promptText="مرتب‌سازی"
                              prefWidth="150"/>

                </HBox>

                <HBox spacing="10"
                      alignment="CENTER_RIGHT">

                    <TextField fx:id="minPriceField"
                               promptText="حداقل قیمت"
                               prefWidth="140"/>

                    <Label text="تا"/>

                    <TextField fx:id="maxPriceField"
                               promptText="حداکثر قیمت"
                               prefWidth="140"/>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Button text="جستجو"
                            prefWidth="120"
                            onAction="#search"
                            styleClass="submit-button"/>

                </HBox>

            </VBox>

            <Label text="جدیدترین آگهی‌ها"
                   styleClass="section-title"/>

            <ProgressIndicator fx:id="loadingIndicator"
                               visible="false"
                               managed="false"/>

            <Label fx:id="messageLabel"
                   visible="false"
                   managed="false"
                   wrapText="true"
                   styleClass="error-message"/>

            <ScrollPane fitToWidth="true"
                        hbarPolicy="NEVER"
                        VBox.vgrow="ALWAYS"
                        styleClass="detail-scroll">

                <content>

                    <FlowPane fx:id="advertisementsPane"
                              alignment="TOP_CENTER"
                              hgap="18"
                              vgap="18"
                              prefWrapLength="900">

                        <padding>
                            <Insets top="10"
                                    right="10"
                                    bottom="10"
                                    left="10"/>
                        </padding>

                    </FlowPane>

                </content>

            </ScrollPane>

        </VBox>

    </center>

</BorderPane>