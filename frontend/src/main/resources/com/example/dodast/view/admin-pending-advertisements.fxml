<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.dodast.Controller.AdminPendingAdvertisementsController"
            prefWidth="1200"
            prefHeight="700"
            styleClass="page"
            nodeOrientation="RIGHT_TO_LEFT">

    <top>
        <HBox spacing="15"
              alignment="CENTER_LEFT"
              styleClass="dark-navbar">

            <padding>
                <Insets top="15"
                        right="20"
                        bottom="15"
                        left="20"/>
            </padding>

            <Button text="بازگشت"
                    onAction="#goBack"
                    styleClass="back-button"/>

            <Label text="آگهی‌های در انتظار تأیید"
                   styleClass="dark-navbar-title"/>

        </HBox>
    </top>

    <center>
        <BorderPane>

            <top>
                <Label fx:id="messageLabel"
                       visible="false"
                       managed="false"
                       wrapText="true"
                       styleClass="error-message">

                    <BorderPane.margin>
                        <Insets top="15"
                                right="20"
                                bottom="5"
                                left="20"/>
                    </BorderPane.margin>

                </Label>
            </top>

            <center>
                <ScrollPane fitToWidth="true"
                            fitToHeight="true"
                            pannable="true"
                            hbarPolicy="NEVER"
                            styleClass="detail-scroll">

                    <content>
                        <FlowPane fx:id="advertisementsPane"
                                  alignment="TOP_CENTER"
                                  hgap="20"
                                  vgap="20"
                                  prefWrapLength="1050">

                            <padding>
                                <Insets top="20"
                                        right="20"
                                        bottom="30"
                                        left="20"/>
                            </padding>

                        </FlowPane>
                    </content>

                </ScrollPane>
            </center>

        </BorderPane>
    </center>

</BorderPane>