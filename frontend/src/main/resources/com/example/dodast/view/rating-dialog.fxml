<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.dodast.Controller.RatingDialogController"
      alignment="CENTER"
      spacing="15"
      prefWidth="400"
      nodeOrientation="RIGHT_TO_LEFT"
      styleClass="rating-dialog">

    <padding>
        <Insets top="30"
                right="30"
                bottom="30"
                left="30"/>
    </padding>

    <Label text="امتیاز به فروشنده"
           styleClass="dialog-title"/>

    <Label text="امتیاز خود را از ۱ تا ۵ انتخاب کنید"
           wrapText="true"
           styleClass="dialog-subtitle"/>

    <ComboBox fx:id="scoreComboBox"
              promptText="انتخاب امتیاز"
              prefWidth="340"
              maxWidth="Infinity"
              styleClass="rating-combo"/>

    <Label text="نظر شما (اختیاری)"
           maxWidth="Infinity"
           styleClass="field-label"/>

    <TextArea fx:id="commentField"
              promptText="نظر خود را بنویسید..."
              prefRowCount="4"
              wrapText="true"
              prefWidth="340"
              maxWidth="Infinity"
              styleClass="rating-comment"/>

    <Label fx:id="messageLabel"
           visible="false"
           managed="false"
           wrapText="true"
           maxWidth="Infinity"
           styleClass="error-message"/>

    <HBox spacing="12"
          alignment="CENTER">

        <Button fx:id="submitButton"
                text="ثبت امتیاز"
                onAction="#submitRating"
                prefWidth="150"
                styleClass="rating-submit-button"/>

        <Button text="انصراف"
                onAction="#cancel"
                prefWidth="120"
                styleClass="secondary-button"/>

    </HBox>

</VBox>