<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.dodast.Controller.AdminDashboardController"
            prefWidth="900"
            prefHeight="600">

    <top>
        <Label fx:id="titleLabel"
               text="پنل مدیریت"
               BorderPane.alignment="CENTER"
               style="-fx-font-size: 26px;
                      -fx-font-weight: bold;
                      -fx-padding: 25px;"/>
    </top>

    <center>
        <VBox alignment="CENTER"
              spacing="18">

            <padding>
                <Insets top="30"
                        right="30"
                        bottom="30"
                        left="30"/>
            </padding>

            <Button text="آگهی‌های در انتظار تأیید"
                    prefWidth="260"
                    prefHeight="45"
                    onAction="#openPendingAdvertisements"/>

            <Button text="مدیریت کاربران"
                    prefWidth="260"
                    prefHeight="45"
                    disable="true"/>

            <Button text="مدیریت دسته‌بندی‌ها"
                    prefWidth="260"
                    prefHeight="45"
                    disable="true"/>

            <Button text="مدیریت شهرها و استان‌ها"
                    prefWidth="260"
                    prefHeight="45"
                    disable="true"/>

            <Button text="خروج"
                    prefWidth="260"
                    prefHeight="45"
                    onAction="#logout"/>
        </VBox>
    </center>

</BorderPane>