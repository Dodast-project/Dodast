<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.dodast.Controller.AdminDashboardController"
            styleClass="page">

    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="15"
              styleClass="navbar">

            <padding>
                <Insets top="15"
                        right="25"
                        bottom="15"
                        left="25"/>
            </padding>

            <Label text="داشبورد مدیر"
                   styleClass="brand"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="آگهی‌های در انتظار"
                    onAction="#openPendingAdvertisements"/>

            <Button text="خروج"
                    onAction="#logout"/>

        </HBox>
    </top>

    <center>
        <VBox alignment="TOP_CENTER"
              spacing="25">

            <padding>
                <Insets top="40"
                        right="30"
                        bottom="30"
                        left="30"/>
            </padding>

            <Label text="آمار سامانه"
                   styleClass="section-title"/>

            <HBox alignment="CENTER"
                  spacing="25">

                <VBox alignment="CENTER"
                      spacing="10"
                      prefWidth="220"
                      prefHeight="140"
                      styleClass="dashboard-card">

                    <Label text="تعداد کاربران"
                           styleClass="dashboard-card-title"/>

                    <Label fx:id="userCountLabel"
                           text="0"
                           styleClass="dashboard-card-number"/>
                </VBox>

                <VBox alignment="CENTER"
                      spacing="10"
                      prefWidth="220"
                      prefHeight="140"
                      styleClass="dashboard-card">

                    <Label text="تعداد کل آگهی‌ها"
                           styleClass="dashboard-card-title"/>

                    <Label fx:id="advertisementCountLabel"
                           text="0"
                           styleClass="dashboard-card-number"/>
                </VBox>

                <VBox alignment="CENTER"
                      spacing="10"
                      prefWidth="220"
                      prefHeight="140"
                      styleClass="dashboard-card">

                    <Label text="در انتظار بررسی"
                           styleClass="dashboard-card-title"/>

                    <Label fx:id="pendingCountLabel"
                           text="0"
                           styleClass="dashboard-card-number"/>
                </VBox>

            </HBox>

            <ProgressIndicator fx:id="loadingIndicator"
                               visible="false"
                               managed="false"/>

            <Label fx:id="messageLabel"
                   visible="false"
                   managed="false"
                   wrapText="true"/>

        </VBox>
    </center>

</BorderPane>