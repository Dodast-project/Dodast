<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.dodast.Controller.AdvertisementDetailController"
            styleClass="detail-page"
            nodeOrientation="RIGHT_TO_LEFT">

    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="15"
              styleClass="detail-navbar">

            <padding>
                <Insets top="16"
                        right="30"
                        bottom="16"
                        left="30"/>
            </padding>

            <Label text="جزئیات آگهی"
                   styleClass="detail-header-title"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="بازگشت"
                    onAction="#backToHome"
                    styleClass="back-button"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    styleClass="detail-scroll">

            <content>
                <VBox alignment="TOP_CENTER"
                      spacing="20">

                    <padding>
                        <Insets top="35"
                                right="40"
                                bottom="40"
                                left="40"/>
                    </padding>

                    <HBox spacing="30"
                          alignment="TOP_CENTER"
                          maxWidth="950"
                          styleClass="detail-card">

                        <padding>
                            <Insets top="25"
                                    right="25"
                                    bottom="25"
                                    left="25"/>
                        </padding>

                        <VBox alignment="TOP_CENTER"
                              spacing="10"
                              prefWidth="430"
                              styleClass="image-container">

                            <ImageView fx:id="advertisementImage"
                                       fitWidth="400"
                                       fitHeight="300"
                                       preserveRatio="true"
                                       smooth="true"
                                       styleClass="detail-image"/>

                            <Label text="تصویر آگهی"
                                   styleClass="image-caption"/>
                        </VBox>

                        <VBox spacing="16"
                              prefWidth="400"
                              alignment="TOP_RIGHT">

                            <Label fx:id="titleLabel"
                                   text="عنوان آگهی"
                                   wrapText="true"
                                   maxWidth="400"
                                   styleClass="advertisement-title"/>

                            <Label fx:id="priceLabel"
                                   text="قیمت"
                                   styleClass="advertisement-price"/>

                            <Region prefHeight="5"/>

                            <HBox spacing="8"
                                  alignment="CENTER_RIGHT"
                                  styleClass="info-row">

                                <Label text="📍"
                                       styleClass="info-icon"/>

                                <Label fx:id="locationLabel"
                                       text="استان، شهر"
                                       wrapText="true"
                                       HBox.hgrow="ALWAYS"/>
                            </HBox>

                            <HBox spacing="8"
                                  alignment="CENTER_RIGHT"
                                  styleClass="info-row">

                                <Label text="🏷"
                                       styleClass="info-icon"/>

                                <Label fx:id="categoryLabel"
                                       text="دسته‌بندی"
                                       wrapText="true"
                                       HBox.hgrow="ALWAYS"/>
                            </HBox>

                            <HBox spacing="8"
                                  alignment="CENTER_RIGHT"
                                  styleClass="info-row">

                                <Label text="♡"
                                       styleClass="favorite-icon"/>

                                <Button fx:id="favoriteButton"
                                        text="افزودن به علاقه‌مندی‌ها"
                                        onAction="#toggleFavorite"
                                        maxWidth="Infinity"
                                        HBox.hgrow="ALWAYS"
                                        styleClass="favorite-button"/>
                            </HBox>

                            <HBox spacing="8"
                                  alignment="CENTER_RIGHT"
                                  styleClass="info-row">

                                <Label text="✉"
                                       styleClass="action-icon"/>

                                <Button fx:id="messageSellerButton"
                                        text="پیام به فروشنده"
                                        onAction="#openMessageSellerDialog"
                                        maxWidth="Infinity"
                                        HBox.hgrow="ALWAYS"
                                        styleClass="favorite-button"/>
                            </HBox>

                            <HBox spacing="8"
                                  alignment="CENTER_RIGHT"
                                  styleClass="info-row">

                                <Label text="★"
                                       styleClass="rating-icon"/>

                                <Button fx:id="rateButton"
                                        text="امتیاز به فروشنده"
                                        onAction="#openRatingDialog"
                                        maxWidth="Infinity"
                                        HBox.hgrow="ALWAYS"
                                        styleClass="favorite-button"/>
                            </HBox>

                            <Region prefHeight="5"/>

                            <VBox spacing="10"
                                  styleClass="description-box">

                                <Label text="توضیحات آگهی"
                                       styleClass="description-title"/>

                                <Label fx:id="descriptionLabel"
                                       text="توضیحات آگهی"
                                       wrapText="true"
                                       maxWidth="360"
                                       styleClass="description-text"/>

                                <Label fx:id="statusLabel"
                                       styleClass="status-label"/>

                            </VBox>
                        </VBox>
                    </HBox>

                    <Label fx:id="messageLabel"
                           visible="false"
                           managed="false"
                           wrapText="true"
                           maxWidth="950"
                           styleClass="error-message"/>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>